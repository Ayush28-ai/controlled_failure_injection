APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Docker Compose overrides DATABASE_URL to use the postgres service.
DATABASE_URL=postgresql+psycopg://bosch:bosch_dev_password@localhost:5432/bosch
POSTGRES_PASSWORD=bosch_dev_password
PROMETHEUS_URL=http://localhost:9090

OPENROUTER_API_KEY=
OPENROUTER_MODEL=YOUR_CHOSEN_MODEL

EXPERIMENT_MODE=simulation
MAX_EXPERIMENT_DURATION_SECONDS=30
